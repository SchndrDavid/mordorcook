# Host port the container is published on. Change it only if it clashes
# with another service on the same host.
MORDORCOOK_PORT=8105

# UID/GID that owns ./data. Match them to the host user, otherwise the
# container cannot write the database or the uploaded photos.
MORDORCOOK_UID=1000
MORDORCOOK_GID=1000

# Contact details published in the User-Agent header of outgoing requests:
# an email address or the URL of your copy of this repository. Wikimedia
# Commons rejects anonymous clients, so photo search falls back to its other
# sources while this is empty. Nothing else depends on it.
MORDORCOOK_CONTACT=
